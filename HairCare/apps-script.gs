// Google Apps Script: Extensions > Apps Script แล้ววางโค้ดนี้
const SHEET_NAME = 'Orders';
function setup(){const ss=SpreadsheetApp.getActiveSpreadsheet();let sh=ss.getSheetByName(SHEET_NAME);if(!sh)sh=ss.insertSheet(SHEET_NAME);if(sh.getLastRow()===0)sh.appendRow(['Order ID','วันที่สั่งซื้อ','SKU','สินค้า','จำนวน','ราคาต่อหน่วย','ยอดรวม','ชื่อลูกค้า','เบอร์โทร','ที่อยู่','หมายเหตุ','สถานะ']);}
function doGet(e){try{setup();const action=e.parameter.action||'orders';if(action!=='orders')return json({ok:false,error:'Unknown action'});const sh=SpreadsheetApp.getActive().getSheetByName(SHEET_NAME),v=sh.getDataRange().getValues();const orders=v.slice(1).filter(r=>r[0]).map(r=>({orderId:r[0],date:r[1],sku:r[2],product:r[3],quantity:r[4],unitPrice:r[5],total:r[6],customer:r[7],phone:r[8],address:r[9],note:r[10],status:r[11]}));return json({ok:true,orders});}catch(err){return json({ok:false,error:String(err)})}}
function doPost(e){try{setup();const d=JSON.parse(e.postData.contents||'{}'),sh=SpreadsheetApp.getActive().getSheetByName(SHEET_NAME);if(d.action==='create'){if(!d.customer||!d.phone||!d.address||!d.sku||Number(d.quantity)<1)throw new Error('กรุณากรอกข้อมูลให้ครบและจำนวนสินค้าต้องมากกว่า 0');const id='SC'+Utilities.formatDate(new Date(),Session.getScriptTimeZone(),'yyyyMMddHHmmss');sh.appendRow([id,new Date(),d.sku,d.product,Number(d.quantity),Number(d.unitPrice),Number(d.total),d.customer,d.phone,d.address,d.note||'','รอดำเนินการ']);return json({ok:true,orderId:id})}if(d.action==='status'){const rows=sh.getDataRange().getValues();for(let i=1;i<rows.length;i++){if(String(rows[i][0])===String(d.orderId)){sh.getRange(i+1,12).setValue(d.status);return json({ok:true})}}throw new Error('ไม่พบคำสั่งซื้อ')}throw new Error('Unknown action')}catch(err){return json({ok:false,error:String(err)})}}
function json(data){return ContentService.createTextOutput(JSON.stringify(data)).setMimeType(ContentService.MimeType.JSON)}
